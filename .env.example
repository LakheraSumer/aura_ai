# Copy to .env (repo root or services/api). Never commit real values.
ENVIRONMENT=local
DEVELOPMENT_MODE=true
DATABASE_URL=postgresql+asyncpg://apna:apna_dev_only@127.0.0.1:55432/apna
REDIS_URL=redis://127.0.0.1:56379/0
TEMPORAL_ADDRESS=127.0.0.1:57233
TEMPORAL_NAMESPACE=apna
JWT_SECRET=change-me-to-a-long-random-string

# Claude planner. Leave empty to use the deterministic rule planner (mock).
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5
PLANNER_EFFORT=medium

DEFAULT_TIMEZONE=Asia/Kolkata
TEST_SITE_BASE_URL=http://127.0.0.1:8899
BROWSER_ALLOWED_DOMAINS=["127.0.0.1","localhost"]

# ---- WhatsApp Cloud API (official). Test-number development only.
# WHATSAPP_PRODUCTION_ENABLED must stay false: Meta's WhatsApp Business Solution terms
# (effective 2026-01-15) bar general-purpose AI assistants. See docs/compliance/WHATSAPP_COMPLIANCE.md
WHATSAPP_ENABLED=false
WHATSAPP_PRODUCTION_ENABLED=false
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_TEST_NUMBERS=[]
WHATSAPP_REMINDER_TEMPLATE=

# ---- Telegram Bot API (launchable channel)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Planner provider: auto | anthropic | openai | gemini | rule
PLANNER_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5.4-mini
# Gemini free tier (test data only: Google may use free-tier prompts to improve its products)
GEMINI_API_KEY=
GEMINI_PLANNER_MODEL=gemini-3.1-flash-lite
# Public instance behind a tunnel/ingress: serve only /v1/webhooks/*
WEBHOOK_ONLY=false

# ---- Secrets at rest (provider tokens, OTPs). REQUIRED to link accounts or use the secure code page.
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
APNA_ENCRYPTION_KEY=
# Public HTTPS base of the webhook-only instance (tunnel/ingress), used for secure-entry links.
PUBLIC_BASE_URL=

# ---- Payments: Razorpay Payment Links (UPI opens GPay/PhonePe/Paytm). Use TEST keys first (rzp_test_...).
# Webhook URL to configure in the Razorpay dashboard: <PUBLIC_BASE_URL>/v1/webhooks/razorpay
# Events: payment_link.paid, payment_link.expired, payment_link.cancelled. Leave empty -> TEST sandbox payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_TTL_MINUTES=20
PAYMENT_POLL_SECONDS=60
# PhonePe PG (registered; adapter not built yet) - merchant onboarding required
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=

# ---- Commerce
QUOTE_TTL_MINUTES=10
OFFER_HOLD_MINUTES=15
PRICE_WATCH_POLL_SECONDS=21600
PRICE_WATCH_DAYS=14
# "Did you do it?" nudge after a reminder, in seconds (0 = off)
REMINDER_FOLLOWUP_SECONDS=1800

# ---- Web search: Tavily (free 1,000 credits/month). Empty -> Google News RSS + Wikipedia (free).
TAVILY_API_KEY=

# ---- Google (Gmail + Calendar), OAuth web client. Redirect URI: <PUBLIC_BASE_URL>/v1/oauth/google/callback
# PUBLIC_BASE_URL must be a FIXED https URL for this (not a quick tunnel).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Reviews (registered; adapter not built yet) - key + card on file at Tripadvisor
TRIPADVISOR_API_KEY=

# ---- Weather (Open-Meteo, no key; free for NON-commercial use only)
WEATHER_BASE_URL=https://api.open-meteo.com
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
